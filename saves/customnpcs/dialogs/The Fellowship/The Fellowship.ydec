,"value":0},{"comparison_type":0,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"Saruman the White is the highest of the Order of the 5 Wizards. Also called the Istari.\nBesides us there are 2 blue wizards, I don't know exactly where they are.. and Radagast the brown one.\n\nI will go now and consult with Saruman in Isengard. He is a good friend of mine and very powerful, if anyone else knows what to do, then he.\nAs soon as I'm done there, we'll meet up in Bree. ","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
