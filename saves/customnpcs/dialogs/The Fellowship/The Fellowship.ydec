ialog_id":8,"position_offset_x":3100,"position_offset_y":12400,"response_title":"What was that noise outside the window?","slot":3,"to_dialog_id":347},{"color_decimal":16451590,"command":"","node_index":140,"option_type":3,"parent_dialog_id":8,"position_offset_x":3100,"position_offset_y":12700,"response_title":"Let's go on an adventure! Goodbye!","slot":4,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":0,"objective_name":"","value":0},{"comparison_type":0,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":1,"text":"Take the ring to Rivendell, Lord Elrond will know what to do.\nIt will be a long and dangerous journey! Meet me halfway in Bree at the Prancing Pony Inn.\nIn the meantime I will visit my old friend Saruman the White... I must consult with him!\n\nGo now @p!! All of Middle-earth is counting on you!!\r","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
