":"","value":0},{"comparison_type":0,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"You've made it far @p !\nA very gloomy place and the days are getting darker!\n\nThere is no going back! We're so close.\nWhether we can trust Gollum I don't know, but we must try.\n\nI will accompany you if you want.\n\n>>(You can take Frodo with you as a companion)<<","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
{"alignment":true,"command":"","connected_response_indexes":[],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":276,"dialog_title":"Frodo follow amon lhaw","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":47,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":300,"position_offset.y":9400,"quest_availabilities":[{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":124415,"command":"/give","node_index":113,"option_type":1,"parent_dialog_id":276,"position_offset_x":700,"position_offset_y":9400,"response_title":"Come with me! (Follower menu)","slot":0,"to_dialog_id":-1},{"color_decimal":15339254,"command":"/give @dp 5171","node_index":114,"option_type":2,"parent_dialog_id":276,"position_offset_x":700,"position_offset_y":9700,"response_title":"I want to fast travel to a map waypoint.","slot":1,"to_dialog_id":-1},{"color_decimal":16714241,"command":"","node_index":115,"option_type":3,"parent_dialog_id":276,"position_offset_x":700,"position_offset_y":10000,"response_title":"Maybe later, Goodbye!","slot":2,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":0,"objective_name":"","value":0},{"comparison_type":0,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"You've made it far @p!\r\rWe found Gollum! He will show us the way to Mordor!\nI think we can trust him.. but the Ring is treacherous.\rMaybe Gollum does deserve to die, but now that I see him, I do pity him.\r\rAnd Gandalf once told me: \rMany that live deserve death. Some that die deserve life. \rCan you give it to them, Frodo? Do not be too eager to deal out death in judgment. \rEven the very wise cannot see all ends.\r\rI do not forget that. \n\n>>(You can take Frodo with you as a companion)<<","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
