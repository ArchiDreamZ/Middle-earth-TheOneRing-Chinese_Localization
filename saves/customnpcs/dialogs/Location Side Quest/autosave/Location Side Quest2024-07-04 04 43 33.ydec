you from time to time.","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
