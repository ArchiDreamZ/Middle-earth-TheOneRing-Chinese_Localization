k like? The old Hay-Gate, of course!\nExcuse my manners, but there's really no time to waste! You have to help me. Please!","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
{"alignment":true,"command":"","connected_response_indexes":[133],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":446,"dialog_title":"Bucklebury15 Gate guard","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":64,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":-1080,"position_offset.y":23760,"quest_availabilities":[{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":14856979,"command":"","node_index":130,"option_type":0,"parent_dialog_id":446,"position_offset_x":-680,"position_offset_y":23680,"response_title":"Ehm... I'm not a wizard, but I'm still happy to help.","slot":0,"to_dialog_id":447},{"color_decimal":14856979,"command":"","node_index":131,"option_type":0,"parent_dialog_id":446,"position_offset_x":-680,"position_offset_y":23920,"response_title":"[Lie] Ehm... Yes! I... can do magic and will take care of it!","slot":1,"to_dialog_id":448},{"color_decimal":14487044,"command":"","node_index":132,"option_type":3,"parent_dialog_id":446,"position_offset_x":-680,"position_offset_y":24160,"response_title":"Goodbye!","slot":2,"to_dialog_id":-1}],"scoreboard_availabilitie