{"alignment":true,"command":"","connected_response_indexes":[127],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":444,"dialog_title":"Bucklebury14 Gate guard","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":62,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":-1880,"position_offset.y":23760,"quest_availabilities":[{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":14856979,"command":"","node_index":133,"option_type":0,"parent_dialog_id":444,"position_offset_x":-1480,"position_offset_y":23760,"response_title":"I'm a friend of Gandalf and a great fighter.","slot":0,"to_dialog_id":446},{"color_decimal":14487044,"command":"","node_index":134,"option_type":3,"parent_dialog_id":444,"position_offset_x":-1480,"position_offset_y":24000,"response_title":"Goodbye!","slot":1,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":1,"objective_name":"","value":0},{"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"That is far too dangerous! They are numerous and driven by evil.\n\nThey came from the east. We were surprised. At first we heard rustling leaves and thought it was a wolf. But there was nothing there except a tree that wasn't there before. We thought it was because of the beer. But then I heard the screams. That was three days ago, since then I've been holding the gate area day and night. \n\nI've never experienced anything like that!","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
