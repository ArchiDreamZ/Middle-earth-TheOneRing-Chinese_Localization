{"alignment":true,"command":"","connected_response_indexes":[],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":254,"dialog_title":"Glorfindel 1","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":18,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":300,"position_offset.y":7300,"quest_availabilities":[{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":457529,"command":"","node_index":46,"option_type":0,"parent_dialog_id":254,"position_offset_x":700,"position_offset_y":7300,"response_title":"Hello, how can i help? (Side Quest start)","slot":0,"to_dialog_id":265},{"color_decimal":16635138,"command":"","node_index":47,"option_type":0,"parent_dialog_id":254,"position_offset_x":700,"position_offset_y":7600,"response_title":"I have found the staffs!","slot":1,"to_dialog_id":266},{"color_decimal":16323338,"command":"","node_index":48,"option_type":3,"parent_dialog_id":254,"position_offset_x":700,"position_offset_y":7900,"response_title":"Maybe later, Goodbye!","slot":2,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":1,"objective_name":"","value":0},{"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"Welcome to Rivendell @p !\rMy name is Glorfindel, I was once the lord of the House of the Golden Flower in Gondolin. \nAfter my death in the First Age, I was re-embodied by the Valar to act as an emissary, \nand returned to Middleearth. I was born in Tirion sometime during the Noontide of Valinor, and was descended from a house of princes.\n\nBack in the days I fought in a lot of battles, the forces of Melkor attacked Gondolin, I even had to fight a Balrog..\nAnd in the battle of Fornost I fought the Witch-King of Angmar.\n\rAnd now i have a new task.. and i could use your help @p!\r\r","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
{"alignment":true,"command":"","connected_response_indexes":[46],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":265,"dialog_title":"Glorfindel 2","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":19,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":1100,"position_offset.y":7300,"quest_availabilities":[{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":16323338,"command":"","node_index":49,"option_type":3,"parent_dialog_id":265,"position_offset_x":1500,"position_offset_y":7300,"response_title":"I will go now, Goodbye!","slot":0,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":1,"objective_name":"","value":0},{"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":73,"text":"A new evil is rising in Middleearth.. I'm not really sure what that is all about yet. But I can feel it.\r\rYou have to help me with a special mission to conquer the staffs of the two Blue Wizards. They got stolen by Orcs.\rI don't know what they need them for, because they are not smart enough to use them. But I'm afrait that they will bring them to someone who is and can use the power against us. Where are the Blue Wizards? You may ask. \r\rWell, noone really knows. They are Istari like Gandalf and Saruman. The last known location of them was in Harlindon and Ost-In-Edhil. But the staffs could be anywhere right know. Maybe we are lucky and can find them there. Go to the Eagle Eyrie in the east and take an Eagle to the locations. I will meet you there. Once you have both staffs, bring them to me here in Rivendell. \r\rThank you @p! See you soon!","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
{"alignment":true,"command":"","connected_response_indexes":[47],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":266,"dialog_title":"Glorfindel 3 finish","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":20,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":1100,"position_offset.y":7600,"quest_availabilities":[{"availability_type":1,"quest_id":73},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":16323338,"command":"","node_index":50,"option_type":3,"parent_dialog_id":266,"position_offset_x":1500,"position_offset_y":7600,"response_title":"Thank you. Goodbye!","slot":0,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":1,"objective_name":"","value":0},{"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"Great! I know I could count on you! Now the ancient staffs are safe and their power can't used by the evil forces anymore.\r\rThey would be safe here in Rivendell, but you are a strong fighter, so they are even more safe in your possesion. So you can keep them and use them. The blue wizards are lost anyways. Or are they? \r\r>>(Will be continued)<<","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
