"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"(Starts singing):\r\rHey! Come merry dol! Derry dol! My darling! Light goes the weather-wind and the feathered starling. \r\rDown along under Hill, shining in the sunlight, Waiting on the doorstep for the cold starlight, \rThere my pretty lady is, River-woman's daughter, \rSlender as the willow-wand, clearer than the water. \r\rOld Tom Bombadil water-lilies bringing comes hopping home again. \rCan you hear him singing? Hey! Come merry dol! Derry dol! ","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
