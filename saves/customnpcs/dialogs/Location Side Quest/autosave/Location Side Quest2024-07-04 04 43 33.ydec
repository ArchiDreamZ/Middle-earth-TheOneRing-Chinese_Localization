{"alignment":true,"command":"","connected_response_indexes":[],"darken_screen":true,"dialog_availabilities":[{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1},{"availability_type":0,"dialog_id":-1}],"dialog_color":16777215,"dialog_id":228,"dialog_title":"Guard 1","disable_esc":false,"faction_availabilities":[{"availability_operator":0,"faction_id":-1,"stance_type":0},{"availability_operator":0,"faction_id":-1,"stance_type":0}],"faction_changes":[{"faction_id":-1,"points":100},{"faction_id":-1,"points":100}],"filename":"res://src/Nodes/DialogNode.tscn","hide_npc":false,"image_dictionary":"{}","lock_visual_preset":false,"mail":{"items":"[{},{},{},{}]","pages":"[]","quest_id":-1,"sender":"","subject":""},"min_level_availability":0,"node_index":22,"node_type":"Dialog Node","npc_offset_x":0,"npc_offset_y":0,"npc_scale":1,"option_offset_x":0,"option_offset_y":0,"option_spacing_x":0,"option_spacing_y":0,"position_offset.x":300,"position_offset.y":8700,"quest_availabilities":[{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1},{"availability_type":0,"quest_id":-1}],"render_gradual":false,"response_options":[{"color_decimal":16514294,"command":"","node_index":54,"option_type":0,"parent_dialog_id":228,"position_offset_x":700,"position_offset_y":8700,"response_title":"Can I help with this problem?","slot":0,"to_dialog_id":229},{"color_decimal":3537175,"command":"","node_index":55,"option_type":0,"parent_dialog_id":228,"position_offset_x":700,"position_offset_y":9000,"response_title":"I'm back and I finished the task!","slot":1,"to_dialog_id":231},{"color_decimal":16256268,"command":"","node_index":56,"option_type":3,"parent_dialog_id":228,"position_offset_x":700,"position_offset_y":9300,"response_title":"Goodbye!","slot":2,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":1,"objective_name":"","value":0},{"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"Welcome adventurer, this is the Forsaken Inn and a nice place to drink a beer and have a good meal.\rBut, in the last days there are less visitors coming, I think they are afraid of the Orcs that are raiding this area.\rThats why i have to guard this tavern. \r\rI'm a mercenary and payed to keep this place safe, so dont cause any trouble around here!","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
