type":0,"parent_dialog_id":336,"position_offset_x":700,"position_offset_y":4000,"response_title":"We did it! The Cold Drake is no more!","slot":3,"to_dialog_id":363},{"color_decimal":16714241,"command":"","node_index":17,"option_type":3,"parent_dialog_id":336,"position_offset_x":700,"position_offset_y":4300,"response_title":"Goodbye!","slot":4,"to_dialog_id":-1}],"scoreboard_availabilities":[{"comparison_type":1,"objective_name":"","value":0},{"comparison_type":1,"objective_name":"","value":0}],"show_previous_dialog":true,"show_response_options":true,"show_wheel":false,"sound":"","spacing_preset":0,"start_quest":-1,"text":"Who is there? I crush your head Orc scum!\r...Oh wait.... you are no enemy.\r\rI'm here to investigate the Halls of my ancestors.\rLong ago it was destroyed by a Cold Drake of the north.\rYou look like a competent fighter, I could use your help!\r\r\r(Quest starts at Dwalin in Beorns Halls)\r>>( You can take Dain Ironfoot with you as a companion )<<","text_height":400,"text_offset_x":0,"text_offset_y":0,"text_pitch":1,"text_sound":"minecraft:random.wood_click","text_width":300,"time_availability":0,"title_color":16777215,"title_pos":0,"visual_preset":0}
